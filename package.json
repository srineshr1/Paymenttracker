{
  "name": "paymenttracker",
  "private": true,
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "mobile": "npm run start -w @paymenttracker/mobile",
    "mobile:android": "npm run android -w @paymenttracker/mobile",
    "test": "npm run test -w @paymenttracker/shared",
    "typecheck": "npm run typecheck -w @paymenttracker/shared && npm run typecheck -w @paymenttracker/mobile",
    "sms:generate": "node scripts/sms-fixtures/generate-sms-fixture.mjs",
    "sms:generate:5m": "node scripts/sms-fixtures/generate-sms-fixture.mjs --days 150 --target 300 --out scripts/sms-fixtures/sms-5months.json",
    "sms:verify": "node scripts/sms-fixtures/verify-sms-parse.mjs",
    "sms:verify:5m": "node scripts/sms-fixtures/verify-sms-parse.mjs --fixture scripts/sms-fixtures/sms-5months.json",
    "sms:inject": "node scripts/sms-fixtures/inject-sms-emulator.mjs",
    "sms:inject:5m": "node scripts/sms-fixtures/inject-sms-emulator.mjs --fixture scripts/sms-fixtures/sms-5months.json",
    "sms:inject:clear": "node scripts/sms-fixtures/inject-sms-emulator.mjs --clear",
    "sms:fixture": "npm run sms:generate && npm run sms:verify",
    "sms:fixture:5m": "npm run sms:generate:5m && npm run sms:verify:5m",
    "lint": "biome check .",
    "lint:fix": "biome check --apply .",
    "format": "biome format .",
    "format:fix": "biome format --write ."
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.4"
  }
}
